# EAS archive is rooted at this repository, but this branch builds only
# apps/garage-link-mobile. Do not let legacy root npm metadata select npm for
# the mobile Expo project; its app-local pnpm lockfile is the build contract.
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Keep this aligned with .gitignore so local dependencies, secrets, and build
# output cannot enter the EAS source snapshot.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/apps/*/.next/
/out/
/apps/*/out/
/build
/apps/*/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!.env.example
!.env.local.example
!apps/**/.env.example
!apps/**/.env.local.example
!.env.secrets.local.example
.vercel
*.tsbuildinfo
next-env.d.ts
.claude/
.codex/
test-results/
.qa-runs/
.webui_secret_key
apps/garage-link/_*.sql
apps/garage-link/_*.mjs
