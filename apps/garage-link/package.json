{
  "name": "@apps/garage-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:security",
    "test:security": "playwright test -c playwright.security.config.ts",
    "test:billing": "playwright test -c playwright.security.config.ts tests/security/garage-billing.test.ts",
    "test:stripe-registry": "node scripts/verify-garage-stripe-test-registry.mjs",
    "test:commercial-contract-drift": "node ../../packages/billing/scripts/generate-garage-commercial-contract.mjs --check",
    "test:e2e:billing": "node scripts/run-billing-e2e.mjs",
    "test:line-link-s2s": "node scripts/check-line-link-s2s.mjs",
    "test:l-link-inquiry-s2s": "node scripts/check-l-link-inquiry-s2s.mjs",
    "test:inquiry-response-management": "node scripts/check-inquiry-response-management.mjs",
    "test:line-link-s2s-ack": "node scripts/check-line-link-s2s-ack.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local-chrome": "node scripts/run-local-browser-smoke.mjs",
    "qa:provision": "node scripts/provision-qa-account.mjs",
    "qa:lifecycle": "node scripts/qa/lifecycle.mjs",
    "test:qa:lifecycle": "node --test tests/qa/*.test.mjs",
    "test:qa:mobile-logout": "node scripts/run-mobile-logout-qa.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:db:runner": "node --test tests/db/migration-runner.test.mjs",
    "test:db:g1c-contract": "node --test tests/db/g1c-relation-contract.test.mjs",
    "test:db:fresh": "bash scripts/db/run-g0b-ci.sh",
    "test:db:db003": "bash scripts/db/run-db003-relation-compatibility.sh",
    "test:g1c:static": "node scripts/check-g1c-service-scope.mjs",
    "test:api:g0b": "bash scripts/db/run-g0b-api-smoke.sh",
    "verify:g0b": "bash scripts/db/run-g0b-full-ci.sh",
    "evidence:g7": "node scripts/generate-g7-high-remediation-evidence.mjs"
  },
  "dependencies": {
    "@garage-link/auth": "workspace:*",
    "@garage-link/billing": "workspace:*",
    "@garage-link/config": "workspace:*",
    "@garage-link/database": "workspace:*",
    "@garage-link/ui": "workspace:*",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
