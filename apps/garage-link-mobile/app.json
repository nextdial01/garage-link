{
  "expo": {
    "name": "GARAGE LINK",
    "slug": "garage-link-mobile",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/app-icon-ios.png",
    "scheme": "garagelink",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kannagi.garagelink",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kannagi.garagelink",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "車両写真を追加するために写真ライブラリを使用します。",
          "cameraPermission": "車両写真を撮影するためにカメラを使用します。"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "NotoSansJP",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/noto-sans-jp/400Regular/NotoSansJP_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/noto-sans-jp/500Medium/NotoSansJP_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/noto-sans-jp/600SemiBold/NotoSansJP_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/noto-sans-jp/700Bold/NotoSansJP_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/noto-sans-jp/800ExtraBold/NotoSansJP_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "extra": {
      "releaseEnvironment": "production",
      "buildProvenance": {
        "sourceSha": "set-by-eas-build",
        "appVersion": "1.0.1",
        "buildNumber": "CFBundleVersion"
      },
      "eas": {
        "projectId": "a4c3cd50-ca8d-4aba-8cd5-0450e7725ced"
      }
    },
    "owner": "ksk13s-team"
  }
}
